# Shared staging values. Copy to .env only on the deployment host.
LINK_PARTNER_HOST=link-partner.staging.example.com
APP_HUB_NETWORK=app-hub-staging_default
KEYCLOAK_AUTHORITY=https://hub.staging.example.com/realms/application-hub
KEYCLOAK_CLIENT_ID=link-partner-frontend
APP_HUB_URL=https://hub.staging.example.com/catalog/link-partner
CORS_ORIGINS=https://link-partner.staging.example.com
DATA_BACKEND=firestore
GOOGLE_CLOUD_PROJECT=replace-me
FIRESTORE_DATABASE_ID=(default)
BOOTSTRAP_ADMIN_EMAILS=

# OpenStreetMap alternative, used only with ADDRESS_SEARCH_PROVIDER=photon.
# Nominatim: explicit searches/reverse lookup, serialized and limited to one call/second.
# Production requires a persistent >=32-character signing secret, supplied by the deployment secret store.
GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=LinkPartner-CX/0.2 address-validation
# GEOCODING_SIGNING_SECRET=

# Autocomplete for the OpenStreetMap alternative; use a private Photon instance for higher volumes.
ADDRESS_AUTOCOMPLETE_URL=https://photon.komoot.io

# One active provider for maps and all address routes. Google is the default; no automatic fallback.
# Google Maps: private server key for Places API (New), never VITE_.
ADDRESS_SEARCH_PROVIDER=google
# GOOGLE_MAPS_API_KEY=
# Separate public browser key restricted to approved referrers, Maps JavaScript API only.
# GOOGLE_MAPS_BROWSER_KEY=

# Google Workspace outbound mail. Authorize the server IP in the relay, or supply account credentials privately.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
# CX_MAIL_FROM=authorized-sender@servnet.mx
CX_PUBLIC_URL=https://ai-stg-node02.serv.net.mx:8081/cx
# SMTP_USER=
# SMTP_PASSWORD=

# Validate staff access against the assigned Application Hub instance.
HUB_API_URL=
HUB_APPLICATION_SLUG=link-partner
HUB_DEPLOYMENT_ID=
HUB_INTERNAL_TENANT_SLUG=
